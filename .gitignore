# ---------------------------------------------------------------------------
# Participant data -- NEVER commit. HRD_RAW_MinuteLevel.csv is minute-level
# heart rate / sleep / screen / call data with depression labels for 166 people
# and is covered by the study's data agreement, not by this repository.
# ---------------------------------------------------------------------------
datasets/*.csv
datasets/HRD_RAW_MinuteLevel.csv
*.csv.gz
*.parquet

# Model weights: encoder.pt is ~235 MB each, well over GitHub's 100 MB hard limit
*.pt
*.pth
*.ckpt

# Run outputs: results_hrd/ alone is ~13 GB across ~18k files. Keep the code in
# git and the results on the cluster / in the scratch copy.
results_hrd/
results_hrd_energy/
results_globem/
logs/
slurm-*.out

# Python cache
__pycache__/
*.pyc
.pytest_cache/

# IDE
.vscode/
.idea/

# Transfer archives: the tarballs used to push code to the cluster and pull
# results back. Both are derived -- the working tree is the source of truth for
# what goes up, and results_hrd/ (already ignored) for what comes down.
*.tgz
*.tar.gz

# Scratch trees from local one-off tests. Named with a leading underscore so
# they sort together and never collide with a real package.
/_*/

# Stray caches. tasks/rhythm.py writes paper_cosinor_topk<N>_cache.npz next to
# the variant dir; running against a variant dir at the repo root lands it here
# instead of under results_hrd/.
/*.npz
_randinit_cache/
